# --- inference provider -----------------------------------------------------
# Omit all of these to use the `replay` provider, which serves recorded
# fixtures and requires no key or network access.
# LEGISWATCH_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_HOST=http://localhost:11434

# --- domain -----------------------------------------------------------------
# LEGISWATCH_INSTITUTION="Indiana University"
# LEGISWATCH_INSTITUTION_CLASS="state educational institution"

# --- guardrails -------------------------------------------------------------
# Minimum similarity for a quote to count as present in its source (0-100).
# LEGISWATCH_FUZZY_THRESHOLD=92.0

# --- routing ----------------------------------------------------------------
# LEGISWATCH_AUTO_FILE_THRESHOLD=0.85
# LEGISWATCH_MIN_VERIFIER_CONFIDENCE=0.75
# Confidence blend weights; must sum to 1.0.
# LEGISWATCH_WEIGHT_EXTRACTOR=0.25
# LEGISWATCH_WEIGHT_VERIFIER=0.45
# LEGISWATCH_WEIGHT_GROUNDEDNESS=0.30

# --- runtime ----------------------------------------------------------------
# LEGISWATCH_OUT_DIR=./out
# LEGISWATCH_LOG_LEVEL=INFO
